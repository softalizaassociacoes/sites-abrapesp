# --- Painel administrativo (/admin) ---
#
# Sem estas duas variáveis o painel não abre: a página de entrada avisa que
# falta configurar e ninguém entra. O site público não muda em nada.

# Segredo que assina o cookie de sessão. Pelo menos 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Quem pode entrar, um por linha, separados por ponto e vírgula:
#   nome:papel:salgado:hash   (papel = editor ou administrador)
# A senha nunca é guardada. Gere a linha de cada pessoa com:
#   node scripts/admin-usuario.mjs <nome> <papel> <senha>
#
# Serve de semente: assim que a primeira conta for criada pelo próprio
# painel, vale src/conteudo-editavel/usuarios.json e esta variável fica
# só como porta de entrada de emergência.
ADMIN_USUARIOS=

# Gravação do painel. Sem elas o painel abre em leitura e avisa que não grava.
# O token precisa de permissão de escrita em Contents neste repositório.
GITHUB_TOKEN=
GITHUB_REPO=softalizaassociacoes/sites-abrapesp
GITHUB_BRANCH=main

# "Esqueci a senha" do painel: o link de redefinição chega por e-mail.
# Sem a chave, a tela orienta a pedir a um administrador, que redefine em
# Contas — o painel continua funcionando.
SENDGRID_API_KEY=
SENDGRID_REMETENTE=tesouraria@abrapesp.org.br

# --- Site ---

# O endereço do site, usado no sitemap e nas metatags.
NEXT_PUBLIC_SITE_URL=https://abrapesp.org.br

# Enquanto for diferente de "true", o site inteiro fica fora dos
# buscadores: robots.txt proibindo tudo e noindex em cada página. É o que
# mantém a homologação fora do Google.
NEXT_PUBLIC_SITE_INDEXAVEL=
